# Safe configuration template. Replace placeholders in the deployment platform.
JWT_SECRET=<generate-a-unique-random-secret-at-least-32-bytes>
JWT_EXPIRATION_MS=86400000
MFA_ENCRYPTION_KEY=<generate-a-stable-random-secret-and-back-it-up>
SPRING_PROFILES_ACTIVE=prod
EUREKA_HOSTPORT=<eureka-private-host>:8761
EUREKA_INSTANCE_HOSTNAME=<service-reachable-hostname>
FRONTEND_ORIGIN=https://<frontend-host>

STUDENT_DATABASE_URL=jdbc:postgresql://<host>:5432/studentdb
STUDENT_DATABASE_USERNAME=<database-user>
STUDENT_DATABASE_PASSWORD=<database-password>
FACULTY_DATABASE_URL=jdbc:postgresql://<host>:5432/facultydb
FACULTY_DATABASE_USERNAME=<database-user>
FACULTY_DATABASE_PASSWORD=<database-password>
ATTENDANCE_DATABASE_URL=jdbc:postgresql://<host>:5432/Attendencedb
ATTENDANCE_DATABASE_USERNAME=<database-user>
ATTENDANCE_DATABASE_PASSWORD=<database-password>
RESULT_DATABASE_URL=jdbc:postgresql://<host>:5432/Resultdb
RESULT_DATABASE_USERNAME=<database-user>
RESULT_DATABASE_PASSWORD=<database-password>

ATTENDANCE_EXCELLENT_THRESHOLD=90
ATTENDANCE_GOOD_THRESHOLD=80
ATTENDANCE_WARNING_THRESHOLD=75
EDUPULSE_DEV_ADMIN_EMAIL=
EDUPULSE_DEV_ADMIN_NAME=
EDUPULSE_DEV_ADMIN_PASSWORD=
FACULTY_DEV_PASSWORD=

# Frontend build-time variables (Vite embeds these in the built bundle).
VITE_API_BASE_URL=/api
VITE_API_GATEWAY_URL=https://<gateway-host>
VITE_NOTIFICATIONS_ENABLED=true
VITE_EDUPULSE_ASSISTANT_ENABLED=true
