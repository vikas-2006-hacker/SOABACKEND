# Copy to backend.local.env and set real local database credentials.
# Set a unique random value shared by all token issuers and validators.
JWT_SECRET=replace-with-a-random-secret-of-at-least-32-bytes
JWT_EXPIRATION_MS=86400000
SPRING_PROFILES_ACTIVE=dev
EUREKA_URL=http://localhost:8761/eureka/
FRONTEND_ORIGIN=http://localhost:5173

# Optional, development-profile-only account seed. Leave blank to require normal provisioning.
EDUPULSE_DEV_ADMIN_EMAIL=
EDUPULSE_DEV_ADMIN_NAME=
EDUPULSE_DEV_ADMIN_PASSWORD=

STUDENT_DATABASE_URL=jdbc:postgresql://localhost:5432/studentdb
STUDENT_DATABASE_USERNAME=postgres
STUDENT_DATABASE_PASSWORD=

FACULTY_DATABASE_URL=jdbc:postgresql://localhost:5432/facultydb
FACULTY_DATABASE_USERNAME=postgres
FACULTY_DATABASE_PASSWORD=
FACULTY_DEV_PASSWORD=

ATTENDANCE_DATABASE_URL=jdbc:postgresql://localhost:5432/Attendencedb
ATTENDANCE_DATABASE_USERNAME=postgres
ATTENDANCE_DATABASE_PASSWORD=
ATTENDANCE_EXCELLENT_THRESHOLD=90
ATTENDANCE_GOOD_THRESHOLD=80
ATTENDANCE_WARNING_THRESHOLD=75

RESULT_DATABASE_URL=jdbc:postgresql://localhost:5432/Resultdb
RESULT_DATABASE_USERNAME=postgres
RESULT_DATABASE_PASSWORD=
